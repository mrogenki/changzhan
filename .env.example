# 複製成 .env.local 後填值。VITE_ 是 build-time 變數：
# 在 Vercel 改完要重新 deploy 才會生效。

# --- Supabase（必填）---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- LINE（每家分會要自己申請，無法共用）---
VITE_LINE_OA_ID=
VITE_LIFF_CARD_ID=
VITE_LIFF_SIGNUP_ID=

# --- 分會識別（不填就是長展的預設值，見 chapterConfig.ts）---
# 只設 SHORT_NAME 就夠了，其餘會自動組出來：
#   SHORT_NAME=長展 → NAME=長展分會、FULL_NAME=BNI 長展分會
VITE_CHAPTER_SHORT_NAME=
VITE_CHAPTER_NAME=
VITE_CHAPTER_FULL_NAME=
VITE_NO_REFERRER_OPTION=
VITE_SITE_URL=

# --- 選填 ---
VITE_BNI_REPORT_URL=
